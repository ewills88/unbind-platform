    "rollback:staging": "npx tsx scripts/rollback.ts staging",
    "rollback:production": "npx tsx scripts/rollback.ts production",
    "backup": "npx tsx scripts/backup.ts full s3",
    "backup:local": "npx tsx scripts/backup.ts full local",
    "restore": "npx tsx scripts/restore.ts",
    "seed:help": "npx tsx scripts/seed-help-content.ts"
