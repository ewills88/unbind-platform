# ===========================================
# UNBIND — Production Environment Variables
# ===========================================
# Copy to Vercel → Settings → Environment Variables
# All values are required unless marked (optional)

# ── Application ──────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://unbind.law
NEXT_PUBLIC_APP_NAME=Unbind
APP_VERSION=1.0.0

# ── Supabase ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://rpbjravqgflidnwjkgvc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                          # Public anon key (safe for client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                               # Secret — never expose to client
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.rpbjravqgflidnwjkgvc.supabase.co:5432/postgres

# ── Authentication ───────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random
JWT_EXPIRES_IN=7d
PORTAL_JWT_SECRET=CHANGE_ME_different_from_above
MAGIC_LINK_SECRET=CHANGE_ME_another_random_secret

# ── Redis (Upstash recommended for Vercel) ───
REDIS_URL=rediss://default:PASSWORD@us1-xyz.upstash.io:6379

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# ── Email (Resend) ──────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@unbind.law
EMAIL_REPLY_TO=support@unbind.law

# ── SMS (Twilio) — optional ─────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── Push Notifications ──────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@unbind.law

# ── Storage ─────────────────────────────────
STORAGE_BUCKET=case-documents
STORAGE_REGION=us-east-1

# ── OpenAI ──────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_VECTOR_STORE_ID=vs_...

# ── Google OAuth (Calendar) ─────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://unbind.law/api/integrations/google/callback

# ── QuickBooks — optional ───────────────────
QUICKBOOKS_CLIENT_ID=...
QUICKBOOKS_CLIENT_SECRET=...
QUICKBOOKS_REDIRECT_URI=https://unbind.law/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production

# ── Tyler Technologies (E-Filing) — optional ─
TYLER_API_URL=https://api.tylertech.com
TYLER_API_KEY=...
TYLER_CLIENT_ID=...

# ── DocuSign — optional ────────────────────
DOCUSIGN_INTEGRATION_KEY=...
DOCUSIGN_SECRET_KEY=...
DOCUSIGN_ACCOUNT_ID=...
DOCUSIGN_BASE_URL=https://www.docusign.net

# ── Monitoring — optional ──────────────────
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...
SENTRY_ORG=unbind
SENTRY_PROJECT=unbind-web

# ── Analytics — optional ──────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Feature Flags ────────────────────────────
NEXT_PUBLIC_FEATURE_CLIENT_PORTAL=true
NEXT_PUBLIC_FEATURE_E_FILING=true
NEXT_PUBLIC_FEATURE_AI_DOCUMENTS=true

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Cron Jobs ────────────────────────────────
CRON_SECRET=CHANGE_ME_random_secret_for_cron_auth

# ── Metrics ──────────────────────────────────
METRICS_SECRET=CHANGE_ME_random_secret_for_metrics

# ── Encryption ───────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters!
